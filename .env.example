# ──────────────────── Bybit Credentials (LIVE account) ───────────
BYBIT_API_KEY=your_live_api_key_here
BYBIT_API_SECRET=your_live_api_secret_here

# Set BOTH to false for LIVE mainnet trading
BYBIT_TESTNET=false
BYBIT_DEMO=false

# false = place real orders; true = simulate only (no orders placed)
DRY_RUN=false

# ──────────────────── Multi-session BTC notional per leg ─────────
# The algo runs TWO entries per trading day (10 trades / week):
#   • afternoon (1st entry) 13:30-15:30 UTC  Mon-Fri  → AFTERNOON_QTY_PER_LEG (default 0.25 BTC)
#   • morning   (2nd entry) 01:00-02:00 UTC  Tue-Sat  → MORNING_QTY_PER_LEG   (default 0.25 BTC)
# Both share the SAME synthetic-straddle structure
#   1 × spot leg + 2 × ITM put legs (all qty_per_leg BTC, same strike)
# and the SAME 0800 UTC expiry within each pair, so e.g. Mon 13:30 UTC +
# Tue 01:00 UTC both expire Tue 08:00 UTC and roll up into the Tue
# trading_day report.
# Daily report is CHAINED off the morning close (Tue-Sat ~02:00 UTC).
# Weekly report is CHAINED off the Saturday morning close.
AFTERNOON_QTY_PER_LEG=0.25
MORNING_QTY_PER_LEG=0.25

# Legacy single-session knob — used only as a fallback default.
QTY_PER_LEG=0.25

# Equity bookkeeping starting point (used until live equity sync overrides)
INITIAL_CAPITAL_USD=8000

# Force exact straddle count regardless of capital (1 = always 1 straddle).
# Set to 0 to enable compound sizing via ALLOC_PCT × current_equity.
NUM_STRADDLES_OVERRIDE=1
ALLOC_PCT=0.80

# Fire an entry immediately on next start (auto-disabled after firing
# so a container restart never silently re-triggers entry).
#   • "false" / unset → no immediate entry, scheduler handles it
#   • "true"          → fires the FIRST session in config.SESSIONS (afternoon)
#   • "afternoon"     → fire the afternoon session immediately
#   • "morning"       → fire the morning session immediately
ENTRY_NOW=false

# Set RESET_STATE_ON_BOOT=true ONCE to wipe equity.json + positions.json
# + trade_log.csv + monthly_volumes.csv at startup. Useful for cutting over
# from demo to a clean live deployment. Auto-disables to false after running,
# same pattern as ENTRY_NOW.
RESET_STATE_ON_BOOT=false

# ──────────────────── Chase Logic ─────────────────────────────────
OPTION_CHASE_DEADLINE_SEC=3600
OPTION_CHASE_GAP_NARROW_PCT=0.5
OPTION_CHASE_MAX_SLIPPAGE_FACTOR=1.15
OPTION_MAX_ENTRY_SPREAD_PCT=0.30

# ──────────────────── Telegram (optional but recommended) ────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_REPORT_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=

# ──────────────────── Logging ─────────────────────────────────────
LOG_LEVEL=INFO
